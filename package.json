{
  "name": "retrolimpia",
  "productName": "RetroLimpia",
  "version": "2.0.1",
  "description": "Limpia, desinstala sin dejar restos, revisa tu hardware y mantiene tus drivers al día. Guiado paso a paso.",
  "main": "src/main.js",
  "author": "Retropunk94",
  "license": "MIT",
  "homepage": "https://github.com/retropunk94/RetroLimpia",
  "retrolimpia": {
    "repo": "retropunk94/RetroLimpia"
  },
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.retropunk94.retrolimpia",
    "productName": "RetroLimpia",
    "copyright": "Código abierto (MIT) - Retropunk94",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts"
      },
      {
        "from": "data",
        "to": "data"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "requireAdministrator",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "license": "build/antes-de-instalar.txt",
      "installerLanguages": [
        "es_ES",
        "en_US"
      ],
      "language": "3082",
      "createDesktopShortcut": true,
      "shortcutName": "RetroLimpia",
      "artifactName": "RetroLimpia-Instalador-${version}.exe"
    },
    "portable": {
      "artifactName": "RetroLimpia-Portable-${version}.exe"
    }
  }
}