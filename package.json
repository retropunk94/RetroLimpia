{
  "name": "retrolimpia",
  "productName": "RetroLimpia",
  "version": "2.7.0",
  "description": "Limpia, desinstala sin dejar restos, revisa tu hardware y mantiene tus drivers al día. Guiado paso a paso.",
  "main": "src/main.js",
  "author": "Retropunk94",
  "license": "MIT",
  "homepage": "https://github.com/retropunk94/RetroLimpia",
  "retrolimpia": {
    "repo": "retropunk94/RetroLimpia",
    "paypal": "https://streamelements.com/retropunk94/tip",
    "reportes": "https://retrolimpia-reportes.arkanosouls.workers.dev/",
    "discord": "https://discord.gg/55zDGujkgU"
  },
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.retropunk94.retrolimpia",
    "productName": "RetroLimpia",
    "copyright": "Código abierto (MIT) - Retropunk94",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts"
      },
      {
        "from": "data",
        "to": "data"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "requireAdministrator",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "license": "build/antes-de-instalar.txt",
      "installerLanguages": [
        "es_ES",
        "en_US"
      ],
      "language": "3082",
      "createDesktopShortcut": true,
      "shortcutName": "RetroLimpia",
      "artifactName": "RetroLimpia-Instalador-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "retropunk94",
        "repo": "RetroLimpia",
        "releaseType": "release"
      }
    ]
  }
}
